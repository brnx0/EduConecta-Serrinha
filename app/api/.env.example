# Server
PORT=3333
NODE_ENV=development
LOG_LEVEL=debug

# Database — banco único com tabelas EDC_* novas e tabelas legadas Softwell (EDU/GER/FR_*)
DATABASE_URL="sqlserver://localhost:1433;database=EDU_<cliente>_M5_DEV;user=sa;password=YourStrong@Passw0rd;encrypt=true;trustServerCertificate=true"
LEGACY_DATABASE_URL="sqlserver://localhost:1433;database=EDU_<cliente>_M5_DEV;user=sa;password=YourStrong@Passw0rd;encrypt=true;trustServerCertificate=true"

# JWT — usar o MESMO secret da API atual pra compatibilidade de tokens
JWT_SECRET=change_me_in_prod_minimum_32_bytes_long_secret_value

# Webhook FR — secret HMAC compartilhado com a API de reconhecimento facial
FR_WEBHOOK_SECRET=change_me_in_prod_minimum_32_bytes_long_secret_value

# Expo Push (opcional — habilita rate limits maiores)
EXPO_ACCESS_TOKEN=

# SMTP — usado pelo fluxo de recuperar senha (lib/email.ts).
# Em DEV, deixar vazio loga e-mails no console em vez de enviar.
# Em PROD, todos obrigatórios.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduConecta <nao-responda@escola.com.br>"
