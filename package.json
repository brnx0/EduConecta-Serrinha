{
  "name": "educonecta-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "mobile": "npm --workspace app/mobile",
    "api": "npm --workspace app/api",
    "mobile:start": "npm --workspace app/mobile run start",
    "mobile:android": "npm --workspace app/mobile run android",
    "api:dev": "npm --workspace app/api run dev",
    "api:test": "npm --workspace app/api run test",
    "api:build": "npm --workspace app/api run build",
    "mobile:ios": "npm --workspace app/mobile run ios"
  },
  "overrides": {
    "postcss": "8.4.49",
    "tailwindcss": "3.3.2",
    "postcss-nested": "5.0.6"
  }
}
